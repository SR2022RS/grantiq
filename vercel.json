{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": null,
  "framework": null,
  "outputDirectory": "public",
  "rewrites": [
    {"source": "/k1-upload", "destination": "/k1-upload.html"},
    {"source": "/k1", "destination": "/k1-upload.html"},
    {"source": "/holigenix-upload", "destination": "/holigenix-upload.html"},
    {"source": "/holigenix", "destination": "/holigenix-upload.html"}
  ],
  "functions": {
    "api/**/*.js": {
      "memory": 1024,
      "maxDuration": 60
    }
  }
}
